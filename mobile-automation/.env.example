# Appium Server Configuration
APPIUM_SERVER_URL=http://127.0.0.1:4723

# Device / Emulator Capabilities
PLATFORM_NAME=Android
PLATFORM_VERSION=13.0
DEVICE_NAME=Android Emulator
UDID=emulator-5554
AUTOMATION_NAME=UiAutomator2

# Application Under Test (Eraspace App)
# Note: Can specify APP_PATH (path to .apk) or APP_PACKAGE / APP_ACTIVITY if already installed on virtual device
APP_PACKAGE=com.eraspace.app
APP_ACTIVITY=com.eraspace.app.presentation.SplashScreenActivity
APP_PATH=

# Test Execution Settings
NO_RESET=true
FULL_RESET=false
COMMAND_TIMEOUT=300
IMPLICIT_WAIT=0
EXPLICIT_WAIT=15
